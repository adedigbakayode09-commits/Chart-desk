# Copy this file to .env (same folder) and fill in what you use. .env is gitignored and only read by the
# local ChartDesk server — keys are never sent to the browser.

# Twelve Data (https://twelvedata.com/pricing — the free Basic plan includes XAU/USD)
TWELVE_DATA_API_KEY=

# Ask Claude chart assistant (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Model for Ask Claude: claude-haiku-5-5 (default, under ~1¢ per request) or claude-opus-5-5 (most capable, ~2–4¢)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Dukascopy tick archive (Requester Pays S3): name an AWS CLI profile, or set the key pair
# AWS_PROFILE=
